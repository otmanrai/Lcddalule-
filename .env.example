# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls (chat, compatibility lookup, etc.).
# Users configure this via the Settings / Secrets panel in the AI Studio UI or .env file.
DEEPSEEK_API_KEY=""

# GEMINI_API_KEY: Optional fallback key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_SITE_VERIFICATION: Google Search Console verification code (Meta Tag content)
GOOGLE_SITE_VERIFICATION=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
